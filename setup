#!/usr/bin/env bash
# Full-Stack Skill — portable runtime and provider audit
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STRICT=0
HAS_COLOR=0
[ -t 1 ] && HAS_COLOR=1

usage() {
    cat <<'EOF'
Usage: bash setup [--strict] [--no-color]

Checks the portable skill structure, detects supported hosts, and reports
optional capability providers. --strict exits non-zero only when the core
skill is invalid; optional integrations never make the check fail.
EOF
}

for arg in "$@"; do
    case "$arg" in
        --strict) STRICT=1 ;;
        --no-color) HAS_COLOR=0 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
    esac
done

green()  { [ "$HAS_COLOR" = 1 ] && printf '\033[32m%s\033[0m' "$1" || printf '%s' "$1"; }
red()    { [ "$HAS_COLOR" = 1 ] && printf '\033[31m%s\033[0m' "$1" || printf '%s' "$1"; }
yellow() { [ "$HAS_COLOR" = 1 ] && printf '\033[33m%s\033[0m' "$1" || printf '%s' "$1"; }
bold()   { [ "$HAS_COLOR" = 1 ] && printf '\033[1m%s\033[0m' "$1" || printf '%s' "$1"; }
ok()     { green 'OK'; }
fail()   { red 'INVALID'; }
info()   { yellow 'optional'; }

printf '\n%s\n\n' "$(bold '=== Full-Stack Skill Runtime Audit ===')"

printf '%s\n' "$(bold 'Core skill')"
printf '%s\n' '-------------------------------------'
CORE_FAILURES=0
CORE_FILES=(
    'SKILL.md'
    'README.md'
    'DEPENDENCIES.md'
    'references/platform-adapters.md'
    'references/four-track-model.md'
    'references/operating-modes.md'
    'references/tracks/product.md'
    'references/tracks/engineering.md'
    'references/tracks/verification.md'
    'references/tracks/delivery-learning.md'
    'references/document-organization.md'
    'references/requirements-workflow.md'
    'references/traceability.md'
    'references/templates/requirements.md'
    'references/templates/change-work-item.md'
    'references/templates/verification-evidence.md'
    'references/templates/traceability-ledger.md'
    'references/templates/traceability-ledger.json'
    'references/schemas/traceability.schema.json'
    'references/templates/version-manifest.md'
    'references/templates/release-manifest.md'
    'references/process-steps.md'
    'references/skills-mapping.md'
    'scripts/validate_skill.py'
    'scripts/validate_traceability.py'
    'scripts/run_evals.py'
    'evals/cases.json'
    'evals/rubric.md'
    'agents/openai.yaml'
)

for relative_path in "${CORE_FILES[@]}"; do
    if [ -f "$SKILL_DIR/$relative_path" ]; then
        printf '  %-40s %s\n' "$relative_path" "$(ok)"
    else
        printf '  %-40s %s\n' "$relative_path" "$(fail) missing"
        CORE_FAILURES=$((CORE_FAILURES + 1))
    fi
done

if ! grep -q '^name: full-stack-skill$' "$SKILL_DIR/SKILL.md" 2>/dev/null; then
    printf '  %-40s %s\n' 'SKILL.md frontmatter name' "$(fail)"
    CORE_FAILURES=$((CORE_FAILURES + 1))
fi

if ! grep -Fq '$full-stack-skill' "$SKILL_DIR/agents/openai.yaml" 2>/dev/null; then
    printf '  %-40s %s\n' 'Codex default prompt' "$(fail) missing explicit invocation"
    CORE_FAILURES=$((CORE_FAILURES + 1))
fi

printf '\n%s\n' "$(bold 'Deterministic validation')"
printf '%s\n' '-------------------------------------'
if command -v python3 >/dev/null 2>&1; then
    if validation_output="$(python3 "$SKILL_DIR/scripts/validate_skill.py" 2>&1)"; then
        printf '  %-40s %s\n' 'Skill/schema/eval validation' "$(ok)"
    else
        printf '  %-40s %s\n' 'Skill/schema/eval validation' "$(fail)"
        printf '%s\n' "$validation_output" | sed 's/^/    /'
        CORE_FAILURES=$((CORE_FAILURES + 1))
    fi
else
    printf '  %-40s %s\n' 'Python 3 validator runtime' "$(fail) missing"
    CORE_FAILURES=$((CORE_FAILURES + 1))
fi

printf '\n%s\n' "$(bold 'Host adapters')"
printf '%s\n' '-------------------------------------'
if command -v codex >/dev/null 2>&1; then
    printf '  %-20s %s (%s)\n' 'Codex CLI' "$(ok)" "$(command -v codex)"
else
    printf '  %-20s %s\n' 'Codex CLI' "$(info) not detected"
fi

if command -v claude >/dev/null 2>&1; then
    printf '  %-20s %s (%s)\n' 'Claude Code CLI' "$(ok)" "$(command -v claude)"
else
    printf '  %-20s %s\n' 'Claude Code CLI' "$(info) not detected"
fi

if [ -f "$SKILL_DIR/AGENTS.md" ]; then
    printf '  %-20s %s\n' 'Repository AGENTS.md' "$(ok)"
else
    printf '  %-20s %s\n' 'Repository AGENTS.md' "$(info) not present"
fi

printf '\n%s\n' "$(bold 'Skill discovery roots')"
printf '%s\n' '-------------------------------------'
CODEX_CONFIG_DIR="${CODEX_HOME:-$HOME/.codex}"
DISCOVERY_ROOTS=(
    "$PWD/.agents/skills"
    "$HOME/.agents/skills"
    "$CODEX_CONFIG_DIR/skills"
    "$HOME/.claude/skills"
)

for discovery_root in "${DISCOVERY_ROOTS[@]}"; do
    if [ -d "$discovery_root" ]; then
        provider_count="$(find "$discovery_root" -mindepth 1 -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')"
        printf '  %-40s %s (%s skills)\n' "$discovery_root" "$(ok)" "$provider_count"
    else
        printf '  %-40s %s\n' "$discovery_root" "$(info) not present"
    fi
done

printf '\n%s\n' "$(bold 'Optional capability providers')"
printf '%s\n' '-------------------------------------'
for provider in gstack superpowers openspec-propose; do
    detected=0
    for discovery_root in "${DISCOVERY_ROOTS[@]}"; do
        if [ -e "$discovery_root/$provider" ]; then
            detected=1
            break
        fi
    done
    if [ "$detected" = 1 ]; then
        printf '  %-20s %s\n' "$provider" "$(ok) detected"
    else
        printf '  %-20s %s\n' "$provider" "$(info) not detected; portable fallback applies"
    fi
done

printf '\n%s\n' "$(bold 'MCP verification')"
printf '%s\n' '-------------------------------------'
if command -v codex >/dev/null 2>&1; then
    printf '  Codex: run %s to inspect configured servers.\n' "$(bold 'codex mcp list')"
fi
if command -v claude >/dev/null 2>&1; then
    printf '  Claude Code: run %s to inspect configured servers.\n' "$(bold 'claude mcp list')"
fi
if ! command -v codex >/dev/null 2>&1 && ! command -v claude >/dev/null 2>&1; then
    printf '  %s No supported host CLI detected; MCP is not required for core operation.\n' "$(info)"
fi

printf '\n%s\n' "$(bold 'Summary')"
printf '%s\n' '-------------------------------------'
if [ "$CORE_FAILURES" -eq 0 ]; then
    printf '  %s Core skill is valid. Optional providers may improve specialized steps.\n' "$(ok)"
else
    printf '  %s %s core check(s) failed.\n' "$(fail)" "$CORE_FAILURES"
fi
printf '  Runtime contract: %s\n\n' "$SKILL_DIR/DEPENDENCIES.md"

if [ "$STRICT" = 1 ] && [ "$CORE_FAILURES" -gt 0 ]; then
    exit 1
fi
