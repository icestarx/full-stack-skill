{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:full-stack-skill:traceability:1",
  "title": "Full-stack traceability ledger",
  "type": "object",
  "required": ["schema_version", "product", "artifacts", "edges", "exceptions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "version_line", "status", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["CAP", "REQ", "RULE", "NFR", "AC", "PDR", "ADR", "CHG", "TASK", "CODE", "TEST", "PR", "BUILD", "RELEASE", "OBS", "BUG", "TECH", "SEC", "OPS", "CONTRACT", "DESIGN"]
          },
          "title": { "type": "string", "minLength": 1 },
          "version_line": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "supersedes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "source_type", "relationship", "target", "target_type", "version_line", "status", "evidence", "owner", "last_verified"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "relationship": {
            "enum": ["contains", "accepted_by", "verified_by", "constrained_by", "planned_by", "implemented_by", "delivered_by", "observed_by", "supersedes", "superseded_by", "blocks"]
          },
          "target": { "type": "string", "minLength": 1 },
          "target_type": { "type": "string", "minLength": 1 },
          "version_line": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "valid", "stale", "blocked", "deprecated"] },
          "evidence": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_or_edge", "rationale", "risk", "alternative_evidence", "approver", "owner", "review_or_expiry", "status"],
        "additionalProperties": false,
        "properties": {
          "artifact_or_edge": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "alternative_evidence": { "type": "string", "minLength": 1 },
          "approver": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "review_or_expiry": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
